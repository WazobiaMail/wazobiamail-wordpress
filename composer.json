{
    "name": "wazobiamail/wazobiamail-wordpress",
    "description": "Send WordPress email through the WazobiaMail API. WazobiaMail is a Resend alternative that also supports SMTP, with automatic domain setup and delivery receipts.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "homepage": "https://wazobiamail.com",
    "authors": [
        {
            "name": "Bowofade Oyerinde",
            "email": "info@bonifadetechnologies.com",
            "homepage": "https://github.com/WazobiaMail"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WazobiaMail\\WordPress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "keywords": [
        "wordpress",
        "wazobiamail",
        "wp_mail",
        "transactional-email",
        "smtp",
        "deliverability",
        "resend-alternative",
        "email-api"
    ]
}
